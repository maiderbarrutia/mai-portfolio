# Configuración del dominio
# Cambia esto por tu dominio en producción
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# Web3Forms - Clave de acceso para el formulario de contacto
# Obtén tu clave en https://web3forms.com
WEB3FORMS_ACCESS_KEY=tu-access-key-aqui

# -----------------------------------------------
# Otros Proyectos — página /otros-proyectos
# Variables SOLO de servidor (sin prefijo NEXT_PUBLIC_):
# nunca llegan al bundle JS ni al repo.
# Local: ponlas en .env (gitignored). Producción: Vercel → Settings → Environment Variables.
# -----------------------------------------------

# Contraseña de acceso a /otros-proyectos
OTROS_PROYECTOS_PASSWORD=tu-password-segura-aqui

# Clave de descifrado AES-256 de data.enc.json (64 caracteres hexadecimales)
# Generar una nueva:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTROS_PROYECTOS_KEY=tu-clave-de-64-hex-aqui

# Los datos de los proyectos NO van en variables de entorno.
# 1. Edita app/otros-proyectos/data.local.json (gitignored, texto plano)
# 2. Ejecuta: node scripts/encrypt-otros-proyectos.mjs
# 3. Sube al repo el resultado: app/otros-proyectos/data.enc.json (cifrado)
# Formato documentado en: app/otros-proyectos/data.example.json
